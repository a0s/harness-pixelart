#!/usr/bin/env bash
# px -- entry point for the pixel-art toolchain.
# Picks the newest available python, keeps the skill's scripts on the path,
# and prefers a project venv if one exists (created by `px doctor --install`).
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/.." && pwd)"
skill="$root/.agents/skills/pixel-art/scripts"

if [[ -x "$root/.venv/bin/python" ]]; then
  PY="$root/.venv/bin/python"
else
  PY=""
  for c in python3.14 python3.13 python3.12 python3.11 python3; do
    if command -v "$c" >/dev/null 2>&1; then PY="$(command -v "$c")"; break; fi
  done
  [[ -n "$PY" ]] || { echo "px: no python3 found" >&2; exit 1; }
fi

if [[ "${1:-}" == "doctor" && "${2:-}" == "--install" ]]; then
  echo "creating $root/.venv and installing Pillow ..."
  "$PY" -m venv "$root/.venv"
  "$root/.venv/bin/python" -m pip install --quiet --upgrade pip Pillow
  PY="$root/.venv/bin/python"
  set -- doctor
fi

exec "$PY" "$skill/cli.py" "$@"
