@meta
name: swordsman
size: 32x32
stage: flats
light: top-left
note: idle loop: breath, weight shift, planted sword
anchor: bottom
fps: 6
timing: 260,180,260,180

@palette
. #00000000 transparent
@ #1a1c2c   ink
% #29366f   cloth-shadow
$ #5d275d   leather
8 #333c57   trouser
N #b13e53   skin-shadow
M #3b5dc9   cloth
A #41a6f6   cloth-lit
c #94b0c2   steel
X #ef7d57   skin
+ #ffcd75   hair
` #f4f4f4   steel-lit

