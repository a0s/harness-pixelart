@meta
name: sheep
size: 40x32
stage: flats
light: top-left
anchor: bottom
fps: 6

@palette
. #00000000 transparent
@ #141727   ink
% #2a3446   face-dark
& #4e6273   face-mid
B #6f8394   face-light
W #6e8f92   fleece-shade-deep
E #9cb9b2   fleece-shade
o #e5d9cd   fleece-mid
- #f7f4f0   fleece-light

@frame idle0
