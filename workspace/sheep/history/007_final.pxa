@meta
name: sheep
size: 40x32
stage: animation
light: top-left
note: slow idle -- breath, fleece settle, chew, ear flick, blink, weight shift
anchor: bottom
fps: 6
timing: 220,170,160,180,200,210,140,200,170,160,190,210

@palette
. #00000000 transparent
@ #141727   ink
% #2a3446   face-dark
& #4e6273   face-mid
B #6f8394   face-light
W #6e8f92   fleece-shade-deep
E #9cb9b2   fleece-shade
o #e5d9cd   fleece-mid
- #f7f4f0   fleece-light

